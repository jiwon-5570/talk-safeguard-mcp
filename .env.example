# 톡세이프가드 MCP 환경변수 예시 파일입니다.
# 실제 실행용 파일은 이 파일을 복사해 `.env`로 만들고, 필요한 값만 수정하세요.
# 주의: `.env`에는 실제 API 키가 들어갈 수 있으므로 GitHub에 올리지 마세요.

# HTTP 서버가 바인딩할 포트입니다.
# 로컬 실행 기본 주소: http://localhost:3000
PORT=3000

# 실행 환경입니다.
# development: 개발/로컬 실행, production: 배포 환경
NODE_ENV=development

# 국세청 사업자등록 상태 조회 API 서비스 키입니다.
# 공공데이터포털에서 발급받은 실제 serviceKey로 교체하세요.
NTS_BUSINESS_API_KEY=replace_with_nts_business_api_key

# 공정거래위원회 통신판매사업자 조회 API 서비스 키입니다.
# 공공데이터포털에서 발급받은 실제 serviceKey로 교체하세요.
FTC_ONLINE_SELLER_API_KEY=replace_with_ftc_online_seller_api_key

# 서버 로그 출력 수준입니다.
# 허용 예: debug, info, warn, error
LOG_LEVEL=info

# 개발용 분석 endpoint(`/debug/analyze`) 활성화 여부입니다.
# 실사용/배포에서는 false를 유지하세요.
ENABLE_DEBUG_ENDPOINT=false

# IP 해시 기준 rate limit 시간 창입니다.
# 60000은 60초를 의미합니다.
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_WINDOW_MS 동안 허용할 최대 요청 수입니다.
# 기본값 60은 1분당 60회 요청을 의미합니다.
RATE_LIMIT_MAX=60

# 프록시/로드밸런서 뒤에서 실행할 때 Express trust proxy 설정을 켤지 여부입니다.
# Render, Railway, Fly.io, Nginx reverse proxy 뒤에서는 true가 필요할 수 있습니다.
TRUST_PROXY=false

# CORS에서 허용할 Origin 목록입니다.
# 쉼표로 여러 개를 구분합니다.
# 개발 환경에서 비워두면 모든 Origin을 허용하지만, 운영 환경에서는 반드시 실제 도메인을 지정하세요.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
