PORT=3000
NODE_ENV=development

NTS_BUSINESS_API_KEY=
FTC_ONLINE_SELLER_API_KEY=

PHISHING_DATA_MODE=sample
SPAM_URL_DATA_MODE=sample
PUBLIC_DATA_MODE=sample

LOG_LEVEL=info
ENABLE_DEBUG_ENDPOINT=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
TRUST_PROXY=false

# 쉼표로 구분한 허용 Origin. 개발 환경에서 비어 있으면 허용하며 production에서는 교차 출처 요청을 거부합니다.
ALLOWED_ORIGINS=
