# 톡세이프가드 MCP 로컬 실행용 환경변수입니다.
# 이 파일은 `.gitignore`에 포함되어 GitHub에 업로드되지 않습니다.
# 실제 API 키를 넣는 경우 절대 커밋하지 마세요.

# HTTP 서버가 바인딩할 포트입니다.
# 로컬 실행 기본 주소: http://localhost:3000
PORT=3000

# 실행 환경입니다.
# development: 개발/로컬 실행, production: 배포 환경
NODE_ENV=development

# 국세청 사업자등록 상태 조회 API 서비스 키입니다.
# PUBLIC_DATA_MODE=actual일 때만 사용됩니다.
# 실제 serviceKey가 있으면 아래 placeholder를 교체하세요.
NTS_BUSINESS_API_KEY=12a3bace0d28d6a6e847b3ca25720d0c97c96a6bde153244116c52311bb76cb4

# 공정거래위원회 통신판매사업자 조회 API 서비스 키입니다.
# PUBLIC_DATA_MODE=actual일 때만 사용됩니다.
# 실제 serviceKey가 있으면 아래 placeholder를 교체하세요.
FTC_ONLINE_SELLER_API_KEY=12a3bace0d28d6a6e847b3ca25720d0c97c96a6bde153244116c52311bb76cb4

# 피싱 데이터 사용 모드입니다.
# 현재 서비스 정보 노출용 값이며, 기본값 sample을 권장합니다.
PHISHING_DATA_MODE=actual

# 스팸 URL 데이터 사용 모드입니다.
# 현재 서비스 정보 노출용 값이며, 기본값 sample을 권장합니다.
SPAM_URL_DATA_MODE=actual

# 공공데이터 API 사용 모드입니다.
# sample: 외부 API를 호출하지 않고 로컬 샘플 fallback 사용
# actual: API 키가 있을 때 국세청/공정위 API 호출, 실패 시 sample fallback 사용
PUBLIC_DATA_MODE=actual

# 서버 로그 출력 수준입니다.
# 허용 예: debug, info, warn, error
LOG_LEVEL=info

# 개발용 분석 endpoint(`/debug/analyze`) 활성화 여부입니다.
# 개발 환경에서는 true, 운영 환경에서는 false 권장
ENABLE_DEBUG_ENDPOINT=true

# IP 해시 기준 rate limit 시간 창입니다.
# 60000은 60초를 의미합니다.
RATE_LIMIT_WINDOW_MS=60000

# RATE_LIMIT_WINDOW_MS 동안 허용할 최대 요청 수입니다.
# 기본값 60은 1분당 60회 요청을 의미합니다.
RATE_LIMIT_MAX=60

# 프록시/로드밸런서 뒤에서 실행할 때 Express trust proxy 설정을 켤지 여부입니다.
# Render, Railway, Fly.io, Nginx reverse proxy 뒤에서는 true가 필요할 수 있습니다.
TRUST_PROXY=false

# CORS에서 허용할 Origin 목록입니다.
# 쉼표로 여러 개를 구분합니다.
# 개발 환경에서 비워두면 모든 Origin을 허용하지만, 운영 환경에서는 반드시 실제 도메인을 지정하세요.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
